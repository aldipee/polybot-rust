[Unit]
Description=Polybot Rust Instance (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/polybot-rust
Environment=POLYBOT_ROOT=/root/polybot-rust
EnvironmentFile=-/etc/default/polybot
ExecStart=/root/polybot-rust/scripts/run-instance.sh %i
Restart=always
RestartSec=2
NoNewPrivileges=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
